{
  "name": "@fca/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API for the Financial Company Analyzer: persistence, Excel import/export and report generation.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
