# ---------------------------------------------------------------------------
# Financial Company Analyzer — environment configuration
# Copy to .env and adjust. Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API. Only needed when the client is
# served from a different origin than the API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Database -------------------------------------------------------------
# Optional. Leave unset to run with in-memory storage: the application is fully
# functional but data does not survive a restart.
# MONGODB_URI=mongodb://127.0.0.1:27017/financial-analyzer

# --- Uploads --------------------------------------------------------------
# Maximum accepted spreadsheet size, in bytes. Default 10 MB.
MAX_UPLOAD_BYTES=10485760

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Optional language layer ----------------------------------------------
# The analysis NEVER depends on this. All metrics, flags and insights are
# produced by the deterministic engine; a model, if configured, only rephrases
# facts the engine has already calculated, and every number it writes is checked
# back against the engine's own output before the text is shown. A rewrite that
# contains a figure the engine did not produce is discarded, not displayed.
#
# A second, separate use is the import mapping review. The text matcher that maps
# spreadsheet row labels onto canonical fields compares strings, so it cannot tell
# a label that merely mentions a term from one that is that term, nor a balance
# sheet position from a cash flow. Those mistakes score above the auto-map
# threshold and are applied without being questioned. When enabled, a model is
# asked about exactly those rows and can only ever DEMOTE one to needing your
# confirmation -- it cannot map a row, and an alternative it proposes is recorded
# below the auto-map threshold so it can never apply on its own. An outage or a
# rejected key therefore leaves the text matcher's plan exactly as it was.
#
# With no key set the application uses its deterministic templates and its text
# matcher, and behaves identically in every other way. Both uses also require
# their own toggle under Settings -> Language model options, and both default to
# off, so a configured deployment can still run entirely on the engine.
#
# This key is read only by the server and is never sent to the browser.
# LLM_API_KEY=

# Which API the key above belongs to: anthropic (default) or groq.
#
# Anthropic is the default because it is the only one verified end to end. Groq speaks a different
# request shape at a different host -- it has no Anthropic-compatible endpoint -- so this switch
# selects a different code path, not just a different URL. See server/src/services/llm.ts.
#
# Groq is called with strict mode, which constrains decoding so the reply is guaranteed to match the
# requested schema. That only holds on the models implementing it, which is why the default is a
# gpt-oss model. A model without strict mode can return prose where an object was required, and the
# application discards that -- quietly reducing the feature to its engine fallback.
# LLM_PROVIDER=anthropic

# Leave unset to get the right default for the provider: claude-opus-5-5 for anthropic,
# openai/gpt-oss-120b for groq. A model name from the wrong provider fails in a way that looks like
# a rejected key, so the server warns at startup if the two do not match. An empty value counts as
# unset, so clearing this field is safe.
# LLM_MODEL=

# --- Client (Vite) --------------------------------------------------------
# Where the Vite dev server forwards /api requests. Read at build time only; it does NOT
# reach the browser bundle. Defaults to http://localhost:$PORT.
API_PROXY_TARGET=http://localhost:4000

# Only variables prefixed VITE_ reach the browser bundle, so never put a secret here.
# Leave this unset unless the API is served from a different origin than the client: by
# default the client calls /api on its own origin, which the dev proxy or your reverse
# proxy forwards to the server. If you do set it, add that origin to CORS_ORIGIN above.
# VITE_API_BASE_URL=https://api.example.com
