# ---------------------------------------------------------------------------
# Financial Company Analyzer — environment configuration
# Copy to .env and adjust. Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API. Only needed when the client is
# served from a different origin than the API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Database -------------------------------------------------------------
# Optional. Leave unset to run with in-memory storage: the application is fully
# functional but data does not survive a restart.
# MONGODB_URI=mongodb://127.0.0.1:27017/financial-analyzer

# --- Uploads --------------------------------------------------------------
# Maximum accepted spreadsheet size, in bytes. Default 10 MB.
MAX_UPLOAD_BYTES=10485760

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Optional language layer ----------------------------------------------
# The analysis NEVER depends on this. All metrics, flags and insights are
# produced by the deterministic engine; an LLM, if configured, only rephrases
# facts the engine has already calculated. With no key set the application uses
# its deterministic insight templates and behaves identically in every other way.
# This key is read only by the server and is never sent to the browser.
# LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_BASE_URL=https://api.anthropic.com/v1/messages

# --- Client (Vite) --------------------------------------------------------
# Where the Vite dev server forwards /api requests. Read at build time only; it does NOT
# reach the browser bundle. Defaults to http://localhost:$PORT.
API_PROXY_TARGET=http://localhost:4000

# Only variables prefixed VITE_ reach the browser bundle, so never put a secret here.
# Leave this unset unless the API is served from a different origin than the client: by
# default the client calls /api on its own origin, which the dev proxy or your reverse
# proxy forwards to the server. If you do set it, add that origin to CORS_ORIGIN above.
# VITE_API_BASE_URL=https://api.example.com
